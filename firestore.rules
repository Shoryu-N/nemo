rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/main/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isValidMessage() {
    return request.resource.data.keys().hasOnly([
      'senderId',
      'senderName',
      'text',
      'createdAt',
    ])
    && request.resource.data.keys().hasAll([
      'senderId',
      'senderName',
      'text',
      'createdAt',
    ])
    && isValidSender(request.resource.data.senderId, request.resource.data.senderName)
    && request.resource.data.text is string
    && request.resource.data.text.size() > 0
    && request.resource.data.text.size() <= 1000
    && request.resource.data.createdAt == request.time;
  }

  function isValidSender(senderId, senderName) {
    return (
      senderId == 'alice' && senderName == 'Alice'
    ) || (
      senderId == 'bob' && senderName == 'Bob'
    );
  }
}
